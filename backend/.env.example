# ==============================================================================
# Incident Response Agent - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Incident Response Agent"
TAGLINE="An AI agent that remembers how your organization solved problems before."
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite async via aiosqlite for local persistence)
DATABASE_URL="sqlite+aiosqlite:///./incidents.db"

# ==============================================================================
# HINDSIGHT PERSISTENT MEMORY (Vectorize.io)
# ==============================================================================
# Base URL for the official Hindsight server (Cloud or self-hosted Docker container)
# e.g., http://localhost:8888 for local Docker or https://api.hindsight.vectorize.io for Cloud
HINDSIGHT_BASE_URL="http://localhost:8888"
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_ID="incident-response-bank"

# Explicit fallback setting:
# If true, the system permits an explicitly-labeled OFFLINE_DEVELOPMENT_MODE when
# the Hindsight server is completely unreachable, but it will NEVER be labeled as Hindsight.
# For the official demo, Hindsight server should be running and verified.
ALLOW_DEV_FALLBACK=true

# ==============================================================================
# LLM / REASONING CONFIGURATION
# ==============================================================================
# Gemini API Key (or provider key)
GEMINI_API_KEY=""
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
